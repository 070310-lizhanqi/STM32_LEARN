# ---------------------------------------------------------------
# STM32 工程通用 .gitignore
# 原则：提交源码和工程配置文件，忽略编译产物与本机个人设置
# ---------------------------------------------------------------

# ---- 编译产物 ----
*.o
*.d
*.crf
*.dep
*.lnp
*.lst
*.map
*.axf
*.elf
*.bin
*.hex
*.sct
*.scr
*.htm
*.build_log.htm

# 编译输出目录
Objects/
Listings/
Debug/
Release/
DebugConfig/
RTE/
build/
Output/
obj/

# ---- Keil MDK-ARM ----
# 注意：*.uvprojx 是工程文件，必须提交，不要忽略
*.uvguix.*          # 个人窗口布局
*.uvoptx            # 个人调试器/断点设置
*.bak
*.scvd
JLinkLog.txt
JLinkSettings.ini

# ---- IAR EWARM ----
*.ewt
*.ewd
*.ewp.bak
settings/

# ---- STM32CubeIDE / Eclipse ----
.settings/
*.launch
.mxproject.bak

# ---- VSCode / Cursor ----
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
!.vscode/extensions.json

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 其他 ----
*.log
*.tmp
